# RTFM Configuration
# Copy to .env and customize as needed

# Infrastructure
REDIS_URL=redis://localhost:6379
MEMORY_SERVER_URL=http://localhost:9200
OLLAMA_BASE_URL=http://localhost:11434/v1

# Models
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMS=768
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=150
TOP_K=5
RERANKER_TOP_K=5
BM25_WEIGHT=0.5

# Caching
CACHE_DISTANCE_THRESHOLD=0.10
CACHE_TTL=3600
SESSION_TTL=86400

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info

# Guardrails (disabled by default)
GUARDRAILS_ENABLED=false
MAX_QUERY_LENGTH=1000
PII_REDACTION=true
MAX_RESPONSE_LENGTH=2000
OFFTOPIC_THRESHOLD=0.15
